{
  "name": "@light4/pi-prompt-history",
  "version": "0.3.2",
  "packageManager": "pnpm@12.8.1",
  "description": "Fuzzy prompt history for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-history"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/light4/pi-prompt-history.git"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@earendil-works/pi-tui": "^1.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
