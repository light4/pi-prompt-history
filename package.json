{
  "name": "@light4/pi-prompt-history",
  "version": "0.2.1",
  "description": "Fuzzy prompt history for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-history"
  ],
  "license": "MIT",
  "repository": "github:light4/pi-prompt-history",
  "files": ["src"],
